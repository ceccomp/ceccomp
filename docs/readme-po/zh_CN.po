#. type: Title #
#: ../README.md:1
#, no-wrap
msgid "Ceccomp"
msgstr "Ceccomp"

#. type: Plain text
#: ../README.md:4
msgid "A tool to analyze seccomp filters like `seccomp-tools`, written in C"
msgstr "用 C 重写的，类似 `seccomp-tools` 的用于分析 seccomp 过滤器的工具"

#. type: Title ##
#: ../README.md:5
#, no-wrap
msgid "Features"
msgstr "功能"

#. type: Bullet: '- '
#: ../README.md:16
msgid ":gear: Robust assembler and disassembler"
msgstr ":gear: 健壮的汇编器和反汇编器"

#. type: Bullet: '- '
#: ../README.md:16
msgid ":blue_book: Complete documentation"
msgstr ":blue_book: 完善的文档"

#. type: Bullet: '- '
#: ../README.md:16
msgid ":1234: Various architecture support powered by libseccomp"
msgstr ":1234: 由 libseccomp 驱动的多架构支持"

#. type: Bullet: '- '
#: ../README.md:16
msgid ":globe_with_meridians: Multi-language support"
msgstr ":globe_with_meridians: 多语言支持"

#. type: Bullet: '- '
#: ../README.md:16
msgid ":feather: Minimum build depencies for core binary"
msgstr ":feather: 构建核心二进制的依赖很少"

#. type: Bullet: '- '
#: ../README.md:16
msgid ":paintbrush: Enhanced syntax highlighting"
msgstr ":paintbrush: 更好的语法高亮"

#. type: Bullet: '- '
#: ../README.md:16
msgid ":100: Informational error messages"
msgstr ":100: 详实的错误信息"

#. type: Bullet: '- '
#: ../README.md:16
msgid ":shell: Powerful Zshell completion"
msgstr ":shell: 强大的 Zshell 补全脚本"

#. type: Bullet: '- '
#: ../README.md:16
msgid ":no_entry_sign: Pure C without LLM-generated garbage"
msgstr ":no_entry_sign: 纯 C 编写，没有 LLM 垃圾"

